{
    "C_Cpp.default.cStandard": "c17",
    "C_Cpp.default.cppStandard": "c++20",
    "C_Cpp.clang_format_style": "{ BasedOnStyle: Google, IndentWidth: 4 }",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.detectIndentation": false,
    "files.associations": {
        "*.h": "c",
        "*.c": "c",
        "*.cpp": "cpp",
        "*.hpp": "cpp"
    },
    "code-runner.runInTerminal": true,
    "code-runner.executorMap": {
        "c": "cd $dir && mkdir -p output && gcc -Wall -Wextra -g $fileName -o output/$fileNameWithoutExt -lm && ./output/$fileNameWithoutExt",
        "cpp": "cd \"$dir\" && mkdir -p output && g++ -Wall -Wextra -std=c++20 -g \"$fileName\" -o \"output/$fileNameWithoutExt\" && \"./output/$fileNameWithoutExt\""
    }
}
